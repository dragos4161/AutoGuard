    "paywall.legal_disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment will be charged to your Apple ID account at confirmation of purchase or at the end of the 7-day free trial. Subscription automatically renews unless cancelled at least 24 hours before the end of the current period. You can manage and cancel your subscriptions anytime in your Apple ID account settings."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plata se va debita din contul tău Apple ID la confirmarea achiziției sau la finalul perioadei de probă de 7 zile. Abonamentul se reînnoiește automat, cu excepția cazului în care este anulat cu cel puțin 24 de ore înainte de sfârșitul perioadei curente. Îți poți gestiona sau anula abonamentul oricând din setările contului Apple ID."
          }
        }
      }
    },
