    "assistant.answer.fallback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can help with mileage, oil changes, or document expirations (insurance, inspection, road tax). Pick a suggestion or ask a related question!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pot să te ajut cu informații despre kilometraj, revizii de ulei sau expirarea actelor (RCA, ITP, Rovinietă). Alege una dintre sugestii sau formulează o întrebare legată de acestea!"
          }
        }
      }
    },
